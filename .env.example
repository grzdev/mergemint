# ========================================================
# MergeMint — GitHub Integration Environment Configuration
# ========================================================

# Integration Mode: "mock" (default, zero credentials) or "real" (live GitHub App)
GITHUB_INTEGRATION_MODE=mock

# GitHub App Authentication (Required when GITHUB_INTEGRATION_MODE=real)
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App Private Key (PEM format)
# Can be provided directly as PEM string (with \n or multiline), base64-encoded,
# or specify a path to the .pem file below
GITHUB_PRIVATE_KEY=
# GITHUB_PRIVATE_KEY_PATH=./secrets/mergemint-private-key.pem

# GitHub App Slug (used for the "Install GitHub App" links)
# e.g., if your app URL is https://github.com/apps/mergemint-dev, the slug is "mergemint-dev"
GITHUB_APP_SLUG=mergemint

# Session Secret (used to encrypt server-side session cookies)
# A secure 32+ character random string (optional in dev, fallback provided)
SESSION_SECRET=

# ========================================================
# MergeMint — Canton / Daml Integration Configuration
# ========================================================

# Integration Mode: "mock" (default, simulated) or "real" (Canton LocalNet / Daml ledger)
CANTON_INTEGRATION_MODE=real

# Canton Participant Node Ledger API endpoint (JSON Ledger API v2)
CANTON_LEDGER_API_URL=http://127.0.0.1:7575

# Canton Network Name (display label)
CANTON_NETWORK="Canton LocalNet"

# Daml Package ID (MergeMint Bounty DAR deployed on ledger)
CANTON_PACKAGE_ID=396bbb895702f963211ab2a69a2b74b53170e513876978af6ddfc7636c217258

# Canton Ledger Authentication Token (if participant node auth is enabled)
# CANTON_AUTH_TOKEN=

# Parties (allocated on Canton participant node)
CANTON_SPONSOR_PARTY=sponsor::1220e791cc2d6fd35cf9e11461772a8f881716cb6074b676edaf5c240c97c1823bff
CANTON_MAINTAINER_PARTY=maintainer::1220e791cc2d6fd35cf9e11461772a8f881716cb6074b676edaf5c240c97c1823bff
CANTON_CONTRIBUTOR_PARTY=contributor::1220e791cc2d6fd35cf9e11461772a8f881716cb6074b676edaf5c240c97c1823bff
