# Zero-configuration preview. Change both modes to real for authenticated LocalNet.
GITHUB_INTEGRATION_MODE=mock
CANTON_INTEGRATION_MODE=mock
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_PATH=secrets/your-app.private-key.pem
GITHUB_APP_SLUG=
# Required in real mode: a randomly generated secret of at least 32 characters.
SESSION_SECRET=
CANTON_LEDGER_API_URL=http://127.0.0.1:7675
CANTON_NETWORK="Canton LocalNet (single-operator demo)"
# Provisioned after starting LocalNet. Never reuse IDs from a previous session.
CANTON_PACKAGE_ID=
CANTON_SPONSOR_PARTY=
CANTON_MAINTAINER_PARTY=
CANTON_CONTRIBUTOR_PARTY=
# Single-operator demonstration only; role checks are separate in code.
CANTON_SPONSOR_GITHUB_LOGIN=grzdev
CANTON_MAINTAINER_GITHUB_LOGIN=grzdev
CANTON_CONTRIBUTOR_GITHUB_LOGIN=grzdev
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
