module MergeMint.Bounty where

import DA.Optional (isNone, isSome, fromSome)

-- | On-ledger MergeMint bounty contract.
-- Represents an escrowed reward locked by a sponsor for a specific GitHub issue.
template MergeMintBounty
  with
    bountyId : Text
    sponsor : Party
    maintainer : Party
    contributor : Optional Party
    repository : Text
    issueNumber : Int
    issueUrl : Text
    amount : Decimal
    asset : Text
    acceptanceCriteria : [Text]
    submissionSha : Optional Text
    status : Text -- "FUNDED" | "CLAIMED" | "APPROVED"
    createdAt : Time
  where
    signatory sponsor
    observer maintainer, optional [] (\p -> [p]) contributor

    ensure
      amount > 0.0 &&
      issueNumber > 0 &&
      repository /= "" &&
      bountyId /= ""

    -- | Choice 1: Contributor claims the funded bounty.
    choice Claim : ContractId MergeMintBounty
      with
        contributorParty : Party
      controller contributorParty
      do
        assertMsg "Bounty has already been claimed." (isNone contributor)
        assertMsg "Only FUNDED bounties can be claimed." (status == "FUNDED")
        create this with
          contributor = Some contributorParty
          status = "CLAIMED"

    -- | Choice 2: Contributor records or updates the PR commit revision SHA.
    -- Invariant: If updated after approval, resets status to CLAIMED to enforce revision-pinning.
    choice SubmitRevision : ContractId MergeMintBounty
      with
        submittingParty : Party
        sha : Text
      controller submittingParty
      do
        assertMsg "Only the assigned contributor can submit work." (contributor == Some submittingParty)
        assertMsg "Commit SHA must not be empty." (sha /= "")
        create this with
          submissionSha = Some sha
          status = "CLAIMED"

    -- | Choice 3: Maintainer approves the exact PR commit revision.
    -- Invariant: Approval is cryptographically bound to the submitted commit SHA.
    choice Approve : ContractId MergeMintBounty
      with
        approvingMaintainer : Party
        sha : Text
      controller approvingMaintainer
      do
        assertMsg "Only the designated maintainer can approve." (approvingMaintainer == maintainer)
        assertMsg "Bounty must have an assigned contributor." (isSome contributor)
        assertMsg "No submission SHA recorded on ledger." (isSome submissionSha)
        assertMsg "Revision mismatch: cannot approve stale or mismatched commit SHA." (submissionSha == Some sha)
        create this with
          status = "APPROVED"

    -- | Choice 4: Atomic settlement releasing funds to the contributor.
    -- Can only be executed on an APPROVED bounty with matching revision SHA.
    -- Archives the bounty (consuming choice) and creates a permanent SettledReceipt.
    choice Settle : ContractId SettledReceipt
      with
        settler : Party
        settlementRef : Text
      controller settler
      do
        assertMsg "Only maintainer or sponsor can settle." (settler == maintainer || settler == sponsor)
        assertMsg "Bounty must be APPROVED before settlement." (status == "APPROVED")
        assertMsg "Bounty must have an assigned contributor." (isSome contributor)
        assertMsg "Settlement reference cannot be empty." (settlementRef /= "")

        now <- getTime
        create SettledReceipt with
          bountyId = bountyId
          sponsor = sponsor
          maintainer = maintainer
          contributor = fromSome contributor
          repository = repository
          issueNumber = issueNumber
          amount = amount
          asset = asset
          approvedSha = fromSome submissionSha
          settlementRef = settlementRef
          settledAt = now

    -- | Choice 5: Sponsor cancellation if unclaimed.
    choice CancelBounty : ()
      with
        cancellingSponsor : Party
      controller cancellingSponsor
      do
        assertMsg "Only sponsor can cancel." (cancellingSponsor == sponsor)
        assertMsg "Cannot cancel a claimed or approved bounty." (isNone contributor)
        return ()

-- | Permanent on-ledger receipt of settled bounty payment.
template SettledReceipt
  with
    bountyId : Text
    sponsor : Party
    maintainer : Party
    contributor : Party
    repository : Text
    issueNumber : Int
    amount : Decimal
    asset : Text
    approvedSha : Text
    settlementRef : Text
    settledAt : Time
  where
    signatory sponsor, maintainer
    observer contributor
